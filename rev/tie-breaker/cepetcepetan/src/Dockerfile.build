FROM python@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends binutils && \
    pip install --no-cache-dir pyinstaller==6.16.0
WORKDIR /src
COPY original.py pack.py ./
RUN python pack.py && pyinstaller --onefile --name chall chall.py

FROM scratch
COPY --from=builder /src/dist/chall /chall
